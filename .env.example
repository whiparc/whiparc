# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real Client Secrets (see apps/api/oauth.go challenge #5).

# Google OAuth app (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: {API_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app (github.com/settings/developers > OAuth Apps)
# Authorization callback URL: {API_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the API itself is reachable from the browser during the OAuth
# redirect round-trip. Defaults to http://localhost:8080 if unset.
API_PUBLIC_URL=http://localhost:8080

# Where to send the browser after a successful OAuth login, AND the only
# origin the API accepts cross-origin requests from (see allowedOrigin() in
# apps/api/main.go) — in production this must be the real frontend origin,
# e.g. https://whiparc.com, not left unset. Defaults to http://localhost:3000
# (and "*" for CORS) if unset, which is only appropriate for local dev.
FRONTEND_URL=http://localhost:3000

# --- Production-only secrets (leave unset for local dev; each has a
# dev-only fallback that logs a warning and must never be used publicly) ---

# Encrypts every stored cloud credential (apps/api/vault). Generate with:
#   openssl rand -base64 32
WHIPARC_MASTER_KEY=

# Signs every session token this API issues. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# Shared secret authenticating the agent-gateway <-> api internal calls; must
# match on both services (see docker-compose.hosted.yml). Generate with:
#   openssl rand -base64 32
GATEWAY_RUNNER_SECRET=

# Selects the SQL backend. Unset (or "sqlite") keeps the default local
# SQLite file; set to "postgres" for a hosted deployment, with DATABASE_URL
# pointing at the Postgres instance (e.g. a Supabase connection string).
DB_DRIVER=
DATABASE_URL=

# Which published image tags the docker-compose files pull by default. Both
# default to "stable" (the most recently tagged vX.Y.Z release — see
# publish-api-image.yml / publish-base-image.yml and whiparc/cloud's
# publish-agent-gateway.yml). Override to "dev" or "main" to track a branch
# instead of a tagged release. There is no equivalent tag for the sandbox-ssh
# image (the "local machine" SSH containers) — that one is always built
# locally from source, since it bakes in a per-installation SSH key
# (sandbox/id_rsa.pub, see docs/DEVELOPMENT.md) that a shared published image
# could never match.
API_IMAGE_TAG=
AGENT_GATEWAY_IMAGE_TAG=
